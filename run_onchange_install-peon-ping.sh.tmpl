#!/bin/bash
# run_onchange_install-peon-ping.sh.tmpl
# Ensures peon-ping is INSTALLED. Deliberately does not keep it CURRENT.
#
# Same policy as brew here: apply guarantees a declared thing is present, and
# never upgrades as a side effect. An upgrade that runs unattended during
# `chezmoi apply` can change behaviour on a machine you were not thinking about,
# and a failure mid-upgrade blocks the scripts queued behind it.
#
# The cost of that policy is silent staleness: this hook sat at 2.7.0 while
# 2.37.0 was available, thirty minor versions behind, because the guard below
# only ever asked "is it present?". So the guard now also REPORTS drift, loudly,
# while still leaving the upgrade to a deliberate `peon.sh update`.
#
# Presence without currency is a choice. It is only a defensible one if the
# staleness is visible.

set -euo pipefail

PEON_DIR="{{ .chezmoi.homeDir }}/.claude/hooks/peon-ping"
PEON_VERSION_FILE="$PEON_DIR/VERSION"
INSTALL_URL="https://raw.githubusercontent.com/PeonPing/peon-ping/main/install.sh"

echo "🔊 Checking peon-ping installation..."

# Check if peon-ping is installed
if [ -f "$PEON_VERSION_FILE" ]; then
    INSTALLED_VERSION=$(cat "$PEON_VERSION_FILE" 2>/dev/null || echo "unknown")
    echo "✓ peon-ping already installed (version: $INSTALLED_VERSION)"

    # peon-ping writes .update_available itself when its own check finds a
    # newer release. Read that rather than hitting the network here: apply
    # should not depend on GitHub being reachable to tell you a version number.
    # The marker can lag behind an update, so compare it to what is installed
    # instead of trusting its mere existence.
    UPDATE_MARKER="$PEON_DIR/.update_available"
    if [ -f "$UPDATE_MARKER" ]; then
        AVAILABLE_VERSION=$(cat "$UPDATE_MARKER" 2>/dev/null || echo "")
        if [ -n "$AVAILABLE_VERSION" ] && [ "$AVAILABLE_VERSION" != "$INSTALLED_VERSION" ]; then
            echo "  ⚠️  peon-ping $AVAILABLE_VERSION is available (installed: $INSTALLED_VERSION)"
            echo "      Upgrades are deliberate here, as with brew. To take it:"
            echo "          $PEON_DIR/peon.sh update"
        fi
    fi
else
    echo "📦 Installing peon-ping..."

    # Ensure Claude hooks directory exists
    mkdir -p "{{ .chezmoi.homeDir }}/.claude/hooks"

    # Install peon-ping
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$INSTALL_URL" | bash
        echo "✓ peon-ping installed successfully!"
    else
        echo "❌ curl not found - cannot install peon-ping"
        echo "   Please install curl or manually install from: https://github.com/PeonPing/peon-ping"
        exit 1
    fi
fi

# Verify installation
if [ -f "$PEON_DIR/peon.sh" ]; then
    echo "✓ peon-ping is ready to use"
else
    echo "⚠️  peon-ping installation may have failed"
    echo "   Expected to find: $PEON_DIR/peon.sh"
fi

# Hash for change detection: {{ .chezmoi.hostname }}-peon-ping-v1.5.6-{{ now | date "2006-01-02" }}
