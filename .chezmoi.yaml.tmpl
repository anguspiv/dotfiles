{{- $configVersion := 1 -}}
{{- $currentVersion := 0 -}}
{{- $needsUpdate := lt $currentVersion $configVersion -}}

{{- $name := promptStringOnce . "name" "What is your full name" -}}
{{- $email := promptStringOnce . "email" "What is your email address" -}}
{{- $personalEmail := promptStringOnce . "personalEmail" "What is your personal email (leave empty if none)" -}}
{{- $workEmail := promptStringOnce . "workEmail" "What is your work email (leave empty if none)" -}}
{{- $signingkey := promptStringOnce . "signingkey" "What is your GPG signing key ID (leave empty if none)" -}}
{{- /*
   signing.sshPublicKey selects the commit-signing mechanism for this machine.
     non-empty - sign with this SSH public key (private half lives in the
                 Proton Pass SSH agent, never on disk)
     empty     - keep signing with GPG and .signingkey above
   Paste the full public key line, e.g.
     ssh-ed25519 AAAAC3Nza... angusp@macbookpro16-light
   Per-machine on purpose: a machine that has not migrated must keep GPG.
*/ -}}
{{- $sshPublicKey := promptStringOnce . "signing.sshPublicKey" "Paste your SSH commit-signing public key (leave empty to keep using GPG)" "" -}}
{{- /*
   machine.type selects which package sets and config blocks apply.
     work     - employer laptop: full dev toolchain, work CLIs, Teams
     personal - Mac Mini M4: full dev toolchain, creative and hobby apps
     light    - MacBook Pro 16": email, web, streaming, audio recording, and a
                remote client for the Mini. No Docker, k8s, databases or Xcode.
   Set once per machine, stored in ~/.config/chezmoi/chezmoi.yaml (gitignored).
   Never gate on .chezmoi.hostname: it resolves through /etc/hosts and has
   silently broken before.
*/ -}}
{{- $machineType := promptChoiceOnce . "machine.type" "What type of machine is this" (list "work" "personal" "light") -}}
{{- $performance := promptChoiceOnce . "machine.performance" "What is the performance level of this machine" (list "high" "medium" "low" "handheld") -}}
{{- $aiTools := promptBoolOnce . "features.ai_tools" "Enable AI tools integration" -}}
{{- $devTools := promptBoolOnce . "features.development_tools" "Enable development tools" -}}
{{- $gitTools := promptBoolOnce . "features.git_tools" "Enable git tools" -}}
{{- $kubernetes := promptBoolOnce . "features.kubernetes" "Enable kubernetes tools" -}}
{{- $docker := promptBoolOnce . "features.docker" "Enable docker tools" -}}

{{- /* Work-specific secrets prompts */ -}}
{{- $writeToken := promptStringOnce . "secrets.write_token" "WRITE_TOKEN (leave empty if none)" -}}
{{- $glToken := promptStringOnce . "secrets.gl_token" "GitLab token (leave empty if none)" -}}
{{- $jiraToken := promptStringOnce . "secrets.jira_token" "JIRA token (leave empty if none)" -}}
{{- $figmaToken := promptStringOnce . "secrets.figma_token" "Figma token (leave empty if none)" -}}
{{- $confluenceToken := promptStringOnce . "secrets.confluence_token" "Confluence token (leave empty if none)" -}}
{{- $confluenceHost := promptStringOnce . "secrets.confluence_host" "Confluence host URL" "" -}}
{{- $confluenceUsername := promptStringOnce . "secrets.confluence_username" "Confluence username" -}}
{{- $gitlabHost := promptStringOnce . "secrets.gitlab_host" "GitLab host" "" -}}

{{- /* Work-specific secrets prompts */ -}}
{{- $workBulkWorkspace := promptStringOnce . "work.bulkworkspace" "Path to your work bulk workspace (leave empty if none)" -}}
{{- $workApiKey := promptStringOnce . "secrets.work_api_key" "Work API key (leave empty if none)" -}}
{{- $workDbUrl := promptStringOnce . "secrets.work_db_url" "Work database URL (leave empty if none)" -}}
{{- $workSlackToken := promptStringOnce . "secrets.work_slack_token" "Work Slack token (leave empty if none)" -}}

data:
  configVersion: {{ $configVersion }}
  name: {{ $name | quote }}
  email: {{ $email | quote }}
  personalEmail: {{ $personalEmail | quote }}
  workEmail: {{ $workEmail | quote }}
  signingkey: {{ $signingkey | quote }}
  machine:
    type: {{ $machineType | quote }}
    performance: {{ $performance | quote }}
  features:
    ai_tools: {{ $aiTools }}
    development_tools: {{ $devTools }}
    git_tools: {{ $gitTools }}
    kubernetes: {{ $kubernetes }}
    docker: {{ $docker }}
  secrets:
    write_token: {{ $writeToken | quote }}
    gl_token: {{ $glToken | quote }}
    jira_token: {{ $jiraToken | quote }}
    figma_token: {{ $figmaToken | quote }}
    confluence_token: {{ $confluenceToken | quote }}
    confluence_host: {{ $confluenceHost | quote }}
    confluence_username: {{ $confluenceUsername | quote }}
    gitlab_host: {{ $gitlabHost | quote }}
  work:
    bulkworkspace: {{ $workBulkWorkspace | quote }}
  signing:
    sshPublicKey: {{ $sshPublicKey | quote }}
  editor: "zed"
  visual: "zed"
  shell: "zsh"
  terminal: "ghostty"
  development:
    languages:
      - "javascript"
      - "typescript"
      - "python"
      - "lua"
      - "bash"
    frameworks:
      - "react"
      - "vue"
      - "node"
    tools:
      - "docker"
      - "git"
      - "tmux"

