{{- if eq .machine.type "steamos" -}}
#!/bin/bash

# SteamOS Package Installation Script with Distrobox
# This script sets up a minimal host system and Distrobox for development

set -e

echo "🐧 Setting up SteamOS with Distrobox development environment..."

# Check if we're actually on SteamOS
if [ ! -f /etc/steamos-release ] && [ ! -f /usr/share/steamos/steamos-release ]; then
    echo "❌ This doesn't appear to be SteamOS. Exiting."
    exit 1
fi

# Function to check if we can use pacman
can_use_pacman() {
    # Check if system is writable
    if mount | grep -q "/ .*ro,"; then
        return 1
    fi
    return 0
}

# Function to enable pacman
enable_pacman() {
    echo "🔓 Enabling pacman (making filesystem writable)..."
    sudo steamos-readonly disable
    
    # Initialize pacman keyring if needed
    if [ ! -d /etc/pacman.d/gnupg ]; then
        sudo pacman-key --init
        sudo pacman-key --populate archlinux
    fi
    
    # Update package database
    sudo pacman -Sy
}

# Function to install minimal host system tools
install_host_essentials() {
    if ! can_use_pacman; then
        enable_pacman
    fi
    
    echo "📦 Installing minimal host system tools..."
    
    # Only essential tools on host system (saves ~1GB+ space)
    sudo pacman -S --noconfirm \
        git \
        neovim \
        tmux \
        zsh \
        curl \
        wget \
        unzip \
        htop \
        starship
}

# Function to install Distrobox
install_distrobox() {
    echo "📦 Installing Distrobox..."
    
    # Install Distrobox to user space
    if [ ! -f ~/.local/bin/distrobox ]; then
        curl -s https://raw.githubusercontent.com/89luca89/distrobox/main/install | sh -s -- --prefix ~/.local
        echo "✅ Distrobox installed to ~/.local/bin"
    else
        echo "✅ Distrobox already installed"
    fi
    
    # Ensure distrobox is in PATH
    if ! grep -q 'export PATH="$HOME/.local/bin:$PATH"' ~/.zshrc 2>/dev/null; then
        echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc
        echo "✅ Added Distrobox to PATH in ~/.zshrc"
    fi
}

# Function to setup development container
setup_dev_container() {
    echo "🐳 Setting up development container..."
    
    # Source PATH for current session
    export PATH="$HOME/.local/bin:$PATH"
    
    # Create development container if it doesn't exist
    if ! distrobox list | grep -q "dev"; then
        echo "📦 Creating Ubuntu development container..."
        distrobox create --name dev --image ubuntu:22.04
        echo "✅ Development container 'dev' created"
    else
        echo "✅ Development container 'dev' already exists"
    fi
    
    # Create chezmoi setup script for container
    cat > ~/.local/bin/setup-dev-container << 'EOF'
#!/bin/bash
echo "🚀 Setting up development environment in container..."

# Update package list
sudo apt update

# Install chezmoi
sh -c "$(curl -fsLS get.chezmoi.io)"

# Clone dotfiles and apply configuration
chezmoi init https://github.com/angusp/dotfiles.git
echo "📝 Run 'chezmoi init' to configure, then 'chezmoi apply' to install development tools"

echo "✅ Container setup complete!"
echo ""
echo "💡 Available commands:"
echo "  chezmoi init    - Configure your preferences"  
echo "  chezmoi apply   - Install development tools"
echo "  exit           - Return to host system"
EOF
    
    chmod +x ~/.local/bin/setup-dev-container
    echo "✅ Container setup script created at ~/.local/bin/setup-dev-container"
}

# Function to install Flatpak applications
install_flatpaks() {
    echo "📱 Setting up Flatpak..."
    
    # Enable Flathub if not already enabled
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    
    # No Flatpak apps installed by default - install manually as needed
    echo "✅ Flatpak configured (install apps manually as needed)"
}

# Function to setup shell
setup_shell() {
    echo "🐚 Setting up shell environment..."
    
    # Change shell to zsh if not already
    if [ "$SHELL" != "/usr/bin/zsh" ] && [ -x "/usr/bin/zsh" ]; then
        chsh -s /usr/bin/zsh
        echo "✅ Changed default shell to zsh"
    fi
}

# Function to setup Steam Deck specific configurations
setup_steam_deck() {
    echo "🎮 Setting up Steam Deck specific configurations..."
    
    # Create desktop shortcuts for development tools
    mkdir -p ~/.local/share/applications
    
    # Terminal shortcut for desktop mode
    cat > ~/.local/share/applications/terminal-dev.desktop << EOF
[Desktop Entry]
Name=Terminal (Dev)
Comment=Terminal for development work
Exec=konsole
Icon=utilities-terminal
Type=Application
Categories=Development;System;
EOF
    
    # Make desktop shortcut executable
    chmod +x ~/.local/share/applications/terminal-dev.desktop
}

# Main installation flow
main() {
    echo "🚀 Starting SteamOS Distrobox setup..."
    
    # Always install minimal host tools
    install_host_essentials
    
    # Always install and setup Distrobox
    install_distrobox
    setup_dev_container
    
    # Setup Flatpak
    install_flatpaks
    
    # Setup shell and Steam Deck specific configs
    setup_shell
    setup_steam_deck
    
    echo "✅ SteamOS Distrobox setup completed!"
    echo ""
    echo "🐳 Development Environment Setup:"
    echo "  1. Enter development container: distrobox enter dev"
    echo "  2. Run setup script: setup-dev-container"
    echo "  3. Configure chezmoi: chezmoi init"
    echo "  4. Install full dev environment: chezmoi apply"
    echo "  5. Exit container: exit"
    echo ""
    echo "💡 Benefits:"
    echo "  • Host system stays minimal (saves root partition space)"
    echo "  • Development tools in container (unlimited space)"
    echo "  • Container survives SteamOS updates"
    echo "  • Access files from both host and container"
    echo ""
    echo "🔄 Next session: Just run 'distrobox enter dev' to start developing"
}

# Run main function
main "$@"
{{ end -}}