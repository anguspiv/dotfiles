# .zshenv - Environment variables for all shells (interactive and non-interactive)
# Generated by chezmoi
# Machine: development (high)

# Editor configuration
export EDITOR=nvim
{{- if lookPath "zed" }}
# GUI editor for tools that check VISUAL first (e.g. Claude Code ctrl+g plan edit);
# --wait blocks until the file closes so the caller sees the edits
export VISUAL="zed --wait"
{{- else }}
export VISUAL="$EDITOR"
{{- end }}

# GPG configuration
export GPG_TTY=$(tty)

# sudo password prompt for TTY-less contexts (agent shells, LaunchAgents, `!` runners):
# a GUI dialog via osascript. Only consulted when sudo is called with -A.
# For a tool that shells out to sudo itself, wrap the whole call in a pty so one
# authentication covers every inner sudo (macOS keys the ticket to the TTY):
#   script -q /dev/null bash -c 'sudo -A -v && <command>'
export SUDO_ASKPASS="$HOME/.local/bin/sudo-askpass.sh"

# PATH management - using typeset -U to keep unique entries
typeset -U path
path=(
{{- /*
  Gated on the DIRECTORY, not the machine name. The former gate was
  a machine-NAME test, which silently went false when a local dev environment
  added a `127.0.0.1 <some-internal-fqdn>` line to /etc/hosts: chezmoi resolves
  the host rather than reading scutil, so .chezmoi.hostname became that other
  name while scutil's ComputerName, LocalHostName and HostName were unchanged.
  Nothing errored --
  the next `chezmoi apply` would just have dropped ~/.aix/bin from PATH.
  A path test says what the gate actually meant: AIX is on PATH iff installed.
*/}}
{{- if stat (joinPath .chezmoi.homeDir ".aix" "bin") }}
    # AIX enterprise CLIs (jira, glab, pat-manager, etc.) — first so they win,
    # and in .zshenv (not .zshrc) so GUI-launched apps (nvim, Neovide) see them too
    $HOME/.aix/bin
{{- end }}
    # Rust toolchain — rustup shims must beat Homebrew's cargo so rust-toolchain.toml
    # pins (e.g. platform-system-prime's nightly) are honored on manual builds
    $HOME/.cargo/bin
    # Homebrew paths (prioritize over system)
    /opt/homebrew/bin
    /opt/homebrew/sbin
    /usr/local/bin
    /usr/local/sbin
    # User paths
    $HOME/.local/bin
    $HOME/.bin
    # System paths
    /usr/bin
    /bin
    /usr/sbin
    /sbin
    $path
)

# Node/PNPM configuration
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Strip stale fnm multishell entries from inherited PATH before fnm adds its own
path=("${(@)path:#*fnm_multishells*}")
# --log-level error silences fnm's "Using Node vX" chatter (info) on every cd into
# a repo with .nvmrc/package.json, while still surfacing genuine fnm errors.
eval "$(fnm --log-level error env --use-on-cd --resolve-engines --corepack-enabled --shell zsh)"

# AI tools integration
export ANTHROPIC_API_KEY_FILE="$HOME/.config/secrets.sh"
export ZED_AWS_PROFILE="default"
export ZED_AWS_REGION="us-east-1"
# Development environment
export DEV_MODE=true
# Enable corepack for high-performance machines
export COREPACK_ENABLE_STRICT=1
{{- if stat (joinPath .chezmoi.homeDir ".cargo" "env") }}
. "$HOME/.cargo/env"
{{- end }}
