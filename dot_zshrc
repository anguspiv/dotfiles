# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# ZPLUG Setup
export ZPLUG_HOME=/usr/local/opt/zplug
source $ZPLUG_HOME/init.zsh

## ZPlug Plugins

zplug "hlissner/zsh-autopair", defer:2
# zplug "ael-code/zsh-colored-man-pages"
zplug "cpitt/zsh-dotenv", as:plugin
zplug "z-shell/zsh-diff-so-fancy", as:command, use:"bin/"
zplug "zdharma-continuum/fast-syntax-highlighting"

# Then, source plugins and add commands to $PATH
zplug load

eval "$(fnm env --use-on-cd --shell zsh)"
eval "$(fnm completions --shell zsh)"

autoload -U compinit
compinit -i

# GPG Signing
export GPG_TTY=$(tty)
gpgconf --launch gpg-agent

# Aliases
alias vi="nvim"
alias ls="eza"
alias ll="eza --icons --long --all --group --header --git"
alias la="eza --icons --long --all --group --header --binary --links --inode --blocks"
alias ld="eza --icons --long --all --group --header --list-dirs"
alias lg="eza --icons --long --all --group --header --git"
alias le="eza --icons --long --all --group --header --extended"
alias lt="eza --icons --long --all --group --header --tree --level"

# Import other files
source_if_exists() {
	if [[ -f $1 ]]; then
		source $1
	fi
}

# Additional Config Files
source_if_exists ~/.config/secrets.sh

# Disable autocorrect
unsetopt correct_all

# Variable Settings
if [[ -z "${EDITOR}" ]]; then
    export EDITOR=nvim
fi
export VISUAL="$EDITOR"

## User Bin
export PATH=$HOME/.bin:$PATH
export PATH="/usr/local/sbin:$PATH"

# Zoxide
eval "$(zoxide init zsh)"

# Yarn
# export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

# iTerm
# source_if_exists "${HOME}/.iterm2_shell_integration.zsh"

# pnpm
export PNPM_HOME="/Users/angusp/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

source <(fzf --zsh)

eval "$(starship init zsh)"

. "$HOME/.local/bin/env"
