{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Installs the core package set plus the set for this machine's profile.
# Profile comes from machine.type in ~/.config/chezmoi/chezmoi.yaml.

{{- $core := .packages.darwin.core -}}
{{- $profile := index .packages.darwin .machine.type -}}
{{- $taps := concat $core.taps $profile.taps -}}
{{- $brews := concat $core.brews $profile.brews -}}
{{- $casks := concat $core.casks $profile.casks -}}
{{- $mas := concat $core.mas $profile.mas }}

echo "📦 Installing packages for profile: {{ .machine.type }}"

# Homebrew refuses to load formulae from untrusted third-party taps. Trust is
# local machine state chezmoi does not manage, so without this a fresh machine
# fails here. Taps are added first so brew trust can resolve them; trust is
# granted per formula rather than per tap, so a tap adding new formulae later
# does not inherit trust silently.
if brew trust --help >/dev/null 2>&1; then
  for tap in {{ range $taps }}{{ . | quote }} {{ end }}; do
    brew tap "$tap" >/dev/null 2>&1 || true
  done

  for formula in {{ range $brews }}{{ . | quote }} {{ end }}; do
    case "$formula" in
      */*/*) brew trust --formula "$formula" >/dev/null 2>&1 || true ;;
    esac
  done
fi

# --no-upgrade is deliberate. chezmoi's job here is to ensure declared packages
# are PRESENT, not to decide when they get upgraded. Without it, `brew bundle`
# upgrades every outdated dependency as a side effect of `chezmoi apply`, and a
# single failure aborts the script - which in turn stops every run_* script
# chezmoi had queued after it. That happened in practice: an upgrade of the
# google-chrome cask failed because Chrome was running (a running app cannot be
# replaced), and it silently blocked the Command Line Tools check, peon-ping,
# the health check and the Claude skills sync.
#
# Upgrades stay a deliberate `brew upgrade`, on the user's schedule.
# Resolve-only mode, for CI. Installing the full profile on a cold runner took
# over 25 minutes and bought no signal this does not: every package failure
# that actually shipped was a RESOLUTION failure - `qmk` declared bare so the
# trust loop never matched it, and brew then refused to load the formula - not
# a broken download. `brew info` loads the formula exactly as an install would,
# hits the same untrusted-tap refusal including transitive dependencies, and
# exits 1 for a formula that does not exist. Same signal, seconds not tens of
# minutes.
#
# Failures are written to a report file rather than exiting non-zero, so this
# keeps the never-abort-the-queue property that the rest of this script has.
# CI asserts on the report; the remaining run_* scripts still get to run and be
# checked in the same build.
if [ "${CHEZMOI_BREW_RESOLVE_ONLY:-0}" = "1" ]; then
  report="${CHEZMOI_BREW_RESOLVE_REPORT:-$HOME/.cache/chezmoi/brew-resolve-failures}"
  mkdir -p "$(dirname "$report")"
  : > "$report"

  echo "🔎 resolve-only: checking every declared package loads (not installing)"
  for formula in {{ range $brews }}{{ . | quote }} {{ end }}; do
    if ! err=$(brew info --formula "$formula" 2>&1); then
      echo "formula: $formula" >> "$report"
      printf '%s\n' "$err" | grep -E 'Error|Refusing' | sed 's/^/    /' >> "$report"
    fi
  done
  for cask in {{ range $casks }}{{ . | quote }} {{ end }}; do
    if ! err=$(brew info --cask "$cask" 2>&1); then
      echo "cask: $cask" >> "$report"
      printf '%s\n' "$err" | grep -E 'Error|Refusing' | sed 's/^/    /' >> "$report"
    fi
  done

  if [ -s "$report" ]; then
    echo "⚠️  some declared packages do not resolve; see $report" >&2
    cat "$report" >&2
  else
    echo "✓ every declared package resolves"
  fi
  exit 0
fi

# Exit status is captured rather than allowed to propagate. chezmoi aborts the
# whole run_* queue when a script exits non-zero, so ANY brew failure here
# silently cancels the Command Line Tools check, peon-ping, the health check
# and the skills sync. --no-upgrade above removed one cause of that (upgrades);
# it did not remove the others - an untrusted third-party tap did it again.
# A package that failed to install is recoverable and visible in the output;
# a cancelled queue is neither. So: warn loudly, never abort.
brew_bundle_status=0
brew bundle --no-upgrade --file=/dev/stdin <<BUNDLE || brew_bundle_status=$?
{{ range $taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range $brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range $casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range $mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
BUNDLE

if [ "$brew_bundle_status" -ne 0 ]; then
  echo "" >&2
  echo "⚠️  brew bundle exited $brew_bundle_status - one or more packages did not install." >&2
  echo "   Continuing so the remaining chezmoi scripts still run." >&2
  echo "   See the brew output above for the failing package, then re-run: chezmoi apply" >&2
fi

exit 0
{{ end -}}
