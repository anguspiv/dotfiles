{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Installs the core package set plus the set for this machine's profile.
# Profile comes from machine.type in ~/.config/chezmoi/chezmoi.yaml.

{{- $core := .packages.darwin.core -}}
{{- $profile := index .packages.darwin .machine.type -}}
{{- $taps := concat $core.taps $profile.taps -}}
{{- $brews := concat $core.brews $profile.brews -}}
{{- $casks := concat $core.casks $profile.casks -}}
{{- $mas := concat $core.mas $profile.mas }}

echo "📦 Installing packages for profile: {{ .machine.type }}"

# Homebrew refuses to load formulae from untrusted third-party taps. Trust is
# local machine state chezmoi does not manage, so without this a fresh machine
# fails here. Taps are added first so brew trust can resolve them; trust is
# granted per formula rather than per tap, so a tap adding new formulae later
# does not inherit trust silently.
if brew trust --help >/dev/null 2>&1; then
  for tap in {{ range $taps }}{{ . | quote }} {{ end }}; do
    brew tap "$tap" >/dev/null 2>&1 || true
  done

  for formula in {{ range $brews }}{{ . | quote }} {{ end }}; do
    case "$formula" in
      */*/*) brew trust --formula "$formula" >/dev/null 2>&1 || true ;;
    esac
  done
fi

# --no-upgrade is deliberate. chezmoi's job here is to ensure declared packages
# are PRESENT, not to decide when they get upgraded. Without it, `brew bundle`
# upgrades every outdated dependency as a side effect of `chezmoi apply`, and a
# single failure aborts the script - which in turn stops every run_* script
# chezmoi had queued after it. That happened in practice: an upgrade of the
# google-chrome cask failed because Chrome was running (a running app cannot be
# replaced), and it silently blocked the Command Line Tools check, peon-ping,
# the health check and the Claude skills sync.
#
# Upgrades stay a deliberate `brew upgrade`, on the user's schedule.
brew bundle --no-upgrade --file=/dev/stdin <<BUNDLE
{{ range $taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range $brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range $casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range $mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
BUNDLE
{{ end -}}
