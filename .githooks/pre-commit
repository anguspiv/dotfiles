#!/usr/bin/env bash
#
# This repository sets a LOCAL core.hooksPath (.githooks), which fully replaces
# the global one rather than layering on it. Without this shim the global secret
# scanner at ~/.config/git/hooks/pre-commit would not run here - in the very
# repository that leaked a GitHub OAuth token (public 2025-01-14 to 2026-09-23)
# and, before that, an SSH private key.
#
# Delegate to the global hook so there is one scanner with one set of rules.

set -u

global_hook="$HOME/.config/git/hooks/pre-commit"

if [ -x "$global_hook" ]; then
    exec "$global_hook" "$@"
fi

printf '%s\n' '' >&2
printf '%s\n' 'pre-commit: WARNING - the global secret scanner was not found at' >&2
printf '%s\n' "            $global_hook" >&2
printf '%s\n' '            Staged content was NOT scanned. Run `chezmoi apply` to deploy it.' >&2
printf '%s\n' '' >&2
exit 0
