# Chezmoi data template - copy to .chezmoidata.yaml and customize for each machine
# This file contains machine-specific data used in templates

# Personal information - customize for each user
name: "Your Name"
email: "your.email@domain.com"

# Machine configuration - adjust based on machine type
machine:
  type: "development"  # development, server, minimal
  performance: "high"  # high, medium, low
  
# Feature flags - enable/disable based on machine needs
features:
  ai_tools: true
  development_tools: true
  git_tools: true
  
# Editor preferences
editor: "nvim"
visual: "nvim"

# Development environment - customize based on your stack
development:
  languages:
    - "javascript"
    - "typescript"
    - "python"
    - "lua"
    - "bash"
  frameworks:
    - "react"
    - "vue"
    - "node"
  tools:
    - "docker"
    - "git"
    - "tmux"