# Source local unmanaged additions (for Obsidian, etc.)
[[ -f "$HOME/.zprofile.local" ]] && source "$HOME/.zprofile.local"

{{- if stat (joinPath .chezmoi.homeDir ".aix" "bin") }}

# AIX enterprise CLIs must win over Homebrew's (glab, jira, ...). This prepend
# looks like a duplicate of the one in .zshenv, and is NOT: macOS runs
# `path_helper` from /etc/zprofile on every LOGIN shell, which REBUILDS PATH and
# pushes anything .zshenv set down the list (measured 2026-09-14: ~/.aix/bin fell
# to position 16, so `glab` and `jira` resolved to /opt/homebrew/bin). .zshenv
# runs before path_helper; .zprofile runs after it, so this is the only place a
# login shell can be made to prefer AIX. Keep both.
export PATH="$HOME/.aix/bin:$PATH"
{{- end }}
