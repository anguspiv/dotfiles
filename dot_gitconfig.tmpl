{{- /*
   Commit signing is per-machine. `dig` rather than .signing.sshPublicKey: a
   machine whose ~/.config/chezmoi/chezmoi.yaml was generated before the
   signing block existed has no such key, and a direct lookup would abort
   every `chezmoi apply` there until it re-ran `chezmoi init`.
*/ -}}
{{- $sshSigningKey := dig "signing" "sshPublicKey" "" . -}}
[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}
{{- if $sshSigningKey }}
	# key:: takes the *public* key literally. The private half is held by the
	# Proton Pass SSH agent and never touches disk, so there is no path to point
	# at, and the key differs per machine.
	signingkey = key::{{ $sshSigningKey }}
{{- else if .signingkey }}
	signingkey = {{ .signingkey }}
{{- end }}
[alias]
	undo = reset HEAD~1 --mixed
	ls = log --pretty=format:\"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]\" --decorate
	lg = log --graph --abbrev-commit --decorate --date=relative
	su = log --all --no-merges --graph --date=relative --committer=angusp@angusp.com --pretty=format:'%C(cyan) %ad %C(yellow)%h %Creset %s %Cgreen%d' --since=\"\"yesterday\"\"
	branch-name = !git rev-parse --abbrev-ref HEAD
	publish = !git push -u origin $(git branch-name)
	unpublish = !git push origin :$(git branch-name)
	code-review = difftool origin/master...
	sq = !git rebase -i $1
	pf = push --force-with-lease
	st = status -sb
	logs = log --show-signature
	cb = checkout -b
	cleanup-branches = "!f() { TARGET=\"${1:-main}\"; echo \"Fetching and pruning...\"; git fetch --prune; echo \"Deleting gone branches...\"; git branch -vv | grep \": gone]\" | awk '{print $1}' | xargs -r git branch -D 2>/dev/null; echo \"Deleting merged branches...\"; git branch --merged \"$TARGET\" | grep -v \"^\\*\" | grep -v \"main\" | grep -v \"master\" | grep -v \"$TARGET\" | xargs -r git branch -d 2>/dev/null; echo \"Checking squashed/rebased...\"; git for-each-ref refs/heads/ \"--format=%(refname:short)\" | while read branch; do case \"$branch\" in main|master|$TARGET|$(git branch --show-current)) continue ;; esac; MERGE_BASE=$(git merge-base \"$TARGET\" \"$branch\" 2>/dev/null) || continue; BRANCH_PATCHES=$(git log --format=%H \"$MERGE_BASE..$branch\" 2>/dev/null | git patch-id --stable 2>/dev/null | cut -d' ' -f1 | sort); [ -z \"$BRANCH_PATCHES\" ] && continue; TARGET_PATCHES=$(git log --format=%H \"$MERGE_BASE..$TARGET\" 2>/dev/null | git patch-id --stable 2>/dev/null | cut -d' ' -f1 | sort); ALL_FOUND=true; for patch in $BRANCH_PATCHES; do echo \"$TARGET_PATCHES\" | grep -q \"^$patch$\" || { ALL_FOUND=false; break; }; done; [ \"$ALL_FOUND\" = true ] && echo \"Deleting squashed: $branch\" && git branch -D \"$branch\" 2>/dev/null; done; echo \"Cleanup complete!\"; }; f"
	brc = !git cleanup-branches
{{- if $sshSigningKey }}
[gpg]
	format = ssh
[gpg "ssh"]
	# Required for local verification (`git log --show-signature`, %G?).
	# GitHub verifies server-side and ignores this.
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
{{- else }}
# GPG signing, for machines not yet migrated to SSH signing.
# Deliberately no gpg.program pin. 9ce912d hardcoded
# /usr/local/MacGPG2/bin/gpg because PATH there preferred Homebrew's gnupg 2.5,
# which cannot read secret keys held by the MacGPG2 2.2 agent. The cure for two
# GPG installs is to not install both, not an absolute path that is wrong on
# Apple Silicon and on every machine without GPG Suite. Let PATH resolve gpg.
{{- end }}
[tag]
	forceSignAnnotated = true
	gpgSign = true
[pull]
	rebase = true
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[commit]
	gpgsign = true
[merge "npm-merge-driver"]
	name = automatically merge npm lockfiles
	driver = npx npm-merge-driver merge %A %O %B %P
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
    required = true
[core]
  	pager = delta
    editor = "smart-git-editor"
	hooksPath = {{ .chezmoi.homeDir }}/.config/git/hooks
[add "interactive"]
	useBuiltin = false
[interactive]
  	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[mergetool "nvimdiff"]
  layout = "LOCAL,BASE,REMOTE / MERGED"
{{- if .work.bulkworkspace }}
[bulkworkspaces]
	work = {{ .work.bulkworkspace }}
{{- end }}
[credential "https://github.com"]
	helper = 
{{- if eq .chezmoi.arch "arm64" }}
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !/usr/local/bin/gh auth git-credential
{{- end }}
[credential "https://gist.github.com"]
	helper = 
{{- if eq .chezmoi.arch "arm64" }}
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !/usr/local/bin/gh auth git-credential
{{- end }}
{{- if .secrets.gitlab_host }}
[credential "https://{{ .secrets.gitlab_host }}"]
	helper = osxkeychain
{{- end }}
