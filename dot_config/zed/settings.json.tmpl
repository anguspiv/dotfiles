// Zed settings - Managed by Chezmoi
// Generated for: {{ .name }} <{{ .email }}>
// Terminal: {{ .terminal }}
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // Assistant and AI configuration - Enhanced for Claude Code
  "always_treat_brackets_as_autoclosed": true,
  "colorize_brackets": true,
  "git_panel": {
    "dock": "right"
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "prettier": {
    "allowed": true
  },
  "agent_ui_font_size": 12.0,
  "ui_font_weight": 500.0,
  "buffer_font_weight": 500.0,
  
  "agent": {
    "use_modifier_to_send": true,
    "play_sound_when_agent_done": true,
    "always_allow_tool_actions": false,
    "notify_when_agent_waiting": "all_screens",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    }
  },
  "audio": {
    "experimental.auto_microphone_volume": true,
    "experimental.rodio_audio": true
  },
  // Auto-updates and extensions
  "auto_update": true,
  "auto_install_extensions": {
    // Core extensions
    "git_firefly": true,
    "vim": true,

    // Language support
    "astro": true,
    "deno": true,
    "graphql": true,
    "html": true,
    "prisma": true,
    "sql": true,
    "scss": true,
    "toml": true,
    "xml": true,

    // Utilities
    "env": true,
    "ini": true,
    "log": true,
    "markdown-oxide": true,
    "nginx": true,
    "rainbow-csv": true,
    "tmux": true,
    "vitest": true,

    // Themes and icons
    "github-dark-default": true,
    "vscode-dark-modern": true,
    "vscode-great-icons": true,
    "vscode-icons": true
  },

  // UI and theme configuration
  "icon_theme": {
    "mode": "system",
    "light": "VSCode Icons for Zed (Light Official Icons)",
    "dark": "VSCode Icons for Zed (Dark Official Icons)"
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Soft",
    "dark": "Ayu Dark"
  },
  "toolbar": {
    "code_actions": true
  },
  "minimap": {
    "current_line_highlight": "line",
    "show": "auto"
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vim": {
    "toggle_relative_line_numbers": true
  },

  // Panel layout
  "project_panel": {
    "dock": "left",
    "default_width": 240
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "notification_panel": {
    "dock": "bottom"
  },

  // Font configuration - keeping MonaspiceNe as primary
  "ui_font_size": 13.0,
  "buffer_font_size": 12.0,
  "buffer_line_height": "standard",
  "buffer_font_family": "VictorMono Nerd Font Propo",
  "buffer_font_features": {
    "liga": true,
    "calt": true
  },
  "ui_font_family": "VictorMono Nerd Font Propo",
  "ui_font_features": {
    "liga": true,
    "calt": true
  },

  // Tab and guide configuration
  "tabs": {
    "git_status": true,
    "file_icons": true
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware"
  },

  // Terminal configuration with smart tmux integration
  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    },
    "font_weight": 500.0,
    "dock": "right",
    "font_size": 12,
    "font_family": "VictorMono Nerd Font Propo",
    "font_features": {
      "liga": true,
      "calt": true
    },
    "line_height": {
      "custom": 1.25
    },
    "copy_on_select": true,
    "env": {
      "GIT_EDITOR": "zed --wait"
    },
    "shell": {
      "with_arguments": {
        "program": "sh",
        "args": [],
        "title_override": null
      }
    }
  },

  // File manager
  "file_manager": {
    "show_hidden_files": true
  },

  // Call settings
  "calls": {
    "mute_on_join": true,
    "mute_on_leave": true,
    "share_on_join": false
  },

  // Editor behavior
  "autoscroll_on_clicks": true,
  "auto_signature_help": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "current_line_highlight": "all",
  "format_on_save": "on",
  "formatter": "auto",

  // Language-specific settings - Enhanced
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      }
    },
    "JSON": {
      "formatter": "prettier"
    },
    "Markdown": {
      "formatter": "prettier"
    }
  },

  // Git integration
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
      "show_commit_summary": true
    }
  },

  // Code guidelines and hints
  "preferred_line_length": 80,
  "show_wrap_guides": true,
  "show_whitespaces": "boundary",
  "show_signature_help_after_edits": true,
  "wrap_guides": [80, 100, 120],
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true
  },

  // Search configuration
  "search": {
    "whole_word": false,
    "case_sensitive": false,
    "include_ignored": false
  }
}
