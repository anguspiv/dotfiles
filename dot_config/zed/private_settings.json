// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "application_id": "126235052055223378866",
  "icon_theme": "VSCode Icons (Dark)",
  "theme": "Github Dark Default",
  "vim_mode": true,
  "ui_font_size": 13,
  "buffer_font_size": 13,
  "buffer_line_height": { "custom": 1.3 },
  "buffer_font_family": "VictorMono Nerd Font Mono",
  "buffer_font_features": {
    "liga": true,
    "calt": true
  },
  "ui_line_height": { "custom": 1.3 },
  "ui_font_family": "VictorMono Nerd Font Mono",
  "ui_font_features": {
    "liga": true,
    "calt": true
  },
  "tabs": {
    "git_status": true,
    "file_icons": true
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware"
  },
  "terminal": {
    "font_size": 12,
    "font_family": "VictorMono Nerd Font Mono",
    "font_features": {
      "liga": true,
      "calt": true
    },
    "line_height": {
      "custom": 1.25
    },
    "copy_on_select": true,
    "env": {
      "GIT_EDITOR": "zed --wait"
    },
    "shell": {
      "with_arguments": {
        "program": "tmux",
        "args": ["new", "-e", "GIT_EDITOR=zed --wait"]
      }
    }
  },
  "file_manager": {
    "show_hidden_files": true
  },
  "calls": {
    "mute_on_join": true,
    "mute_on_leave": true,
    "share_on_join": false,
    "share_on_leave": false,
    "share_on_invite": false
  },
  "current_line_highlight": "all",
  "format_on_save": "on",
  "formatter": "auto",
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    }
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
      "show_commit_summary": true
    }
  },
  "preferred_line_length": 80,
  "show_wrap_guides": true,
  "show_whitespaces": "all",
  "show_signature_help_after_edits": true,
  "wrap_guides": [80, 100, 120]
}
