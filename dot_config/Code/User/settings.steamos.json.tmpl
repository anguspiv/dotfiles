{{- if eq .machine.type "steamos" -}}
{
  // Steam Deck optimized VS Code settings
  
  // Font settings with Victor Mono
  "editor.fontFamily": "VictorMono Nerd Font",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.lineHeight": 24,
  "terminal.integrated.fontFamily": "VictorMono Nerd Font",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontLigatures": true,
  
  // UI scaling for handheld screen
  "window.zoomLevel": 1.5,
  "editor.mouseWheelZoom": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Material Theme Darker",
  
  // Touch-friendly settings
  "editor.minimap.enabled": true,
  "editor.minimap.size": "large",
  "workbench.activityBar.visible": true,
  "workbench.statusBar.visible": true,
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontal": "visible",
  
  // Development optimizations for handheld performance
  "editor.semanticHighlighting.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggestSelection": "first",
  
  // File management
  "files.autoSave": "onWindowChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  
  // Integrated terminal optimizations
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "/usr/bin/zsh",
      "args": ["-l"]
    }
  },
  
  // Remote development settings
  "remote.containers.defaultExtensions": [
    "ms-vscode.vscode-typescript-next",
    "esbenp.prettier-vscode",
    "ms-python.python",
    "golang.go",
    "rust-lang.rust-analyzer"
  ],
  
  // Language-specific settings
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnSave": true
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  
  // Extensions for Steam Deck development
  "extensions.ignoreRecommendations": false,
  "extensions.showRecommendationsOnlyOnDemand": false,
  
  // Performance settings for handheld constraints
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/target": true
  },
  
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/target/**": true
  },
  
  // Git integration
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.suggestSmartCommit": true,
  
  // Debugging settings
  "debug.console.fontSize": 14,
  "debug.inlineValues": "auto",
  "debug.terminal.clearBeforeReusing": true,
  
  // Workbench settings for development focus
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabCloseButton": "right",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  
  // Explorer settings
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 0,
  
  // Steam Deck specific tweaks
  "window.menuBarVisibility": "compact",
  "window.titleBarStyle": "custom",
  "breadcrumbs.enabled": true,
  "outline.showVariables": false,
  
  // Battery-conscious settings
  "editor.renderWhitespace": "boundary",
  "editor.renderControlCharacters": false,
  "editor.minimap.renderCharacters": false,
  "workbench.reduceMotion": "on"
}
{{ end -}}