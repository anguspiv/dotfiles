#!/bin/bash
# run_onchange_health-check.sh.tmpl

# Chezmoi health check and maintenance
echo "🔍 Running Chezmoi health check for {{ .chezmoi.hostname }}..."

# Check for missing critical packages
missing_packages=()
critical_tools=("git" "zsh" "{{ .editor }}")

{{- if .features.development_tools }}
critical_tools+=("node" "npm")
{{- end }}

{{- /* Expect docker only where this profile installs it (packages.yml), so the
     light profile - which omits Docker by design - does not warn every run. */}}
{{- $casks := concat .packages.darwin.core.casks (index .packages.darwin .machine.type).casks }}
{{- if and .features.development_tools (has "docker-desktop" $casks) }}
critical_tools+=("docker")
{{- end }}

for tool in "${critical_tools[@]}"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        missing_packages+=("$tool")
    fi
done

if [ ${#missing_packages[@]} -gt 0 ]; then
    echo "⚠️  Missing critical tools: ${missing_packages[*]}"
fi

# Check chezmoi status
if ! chezmoi doctor >/dev/null 2>&1; then
    echo "🩺 Chezmoi doctor found issues - run 'chezmoi doctor' for details"
fi

# Check git status in chezmoi repo
cd ~/.local/share/chezmoi
if [ -n "$(git status --porcelain)" ]; then
    echo "📝 Uncommitted changes in chezmoi repo:"
    git status --porcelain
fi

{{- if eq .chezmoi.os "darwin" }}
# Check for outdated packages on macOS
if command -v brew >/dev/null 2>&1; then
    outdated=$(brew outdated --quiet | head -5)
    if [ -n "$outdated" ]; then
        echo "📦 Top 5 outdated packages:"
        echo "$outdated"
    fi
fi
{{- end }}

# Check shell integration
if [[ "$SHELL" != "$(command -v {{ .shell }})" ]]; then
    echo "⚠️  Shell mismatch: SHELL=$SHELL but expected {{ .shell }}"
fi

{{- if .features.ai_tools }}
# Check AI tool configuration
if [[ -z "$ANTHROPIC_API_KEY" ]]; then
    echo "🤖 ANTHROPIC_API_KEY not set - check ~/.config/secrets.sh"
fi
{{- end }}

# Check tmux sessions (if any)
if command -v tmux >/dev/null 2>&1; then
    session_count=$(tmux list-sessions 2>/dev/null | wc -l)
    if [ "$session_count" -gt 5 ]; then
        echo "🖥️  Many tmux sessions running ($session_count) - consider cleanup"
    fi
fi

# Check disk space on macOS
if [[ "$(df -h / | awk 'NR==2{print $5}' | sed 's/%//')" -gt 85 ]]; then
    echo "💾 Disk space low (>85% full)"
fi

# Check inbound SSH hardening.
#
# Gated on this profile authorising any inbound key: if nobody may log in,
# there is nothing to harden. /etc is outside chezmoi (see .chezmoidata/sshd.yml
# for why), so this REPORTS drift rather than fixing it.
{{- if index .fleet.sshAuthorizedKeys .machine.type }}
SSHD_DROPIN="{{ .sshd.hardeningDropIn }}"
if [ ! -f "$SSHD_DROPIN" ]; then
    echo "🔓 inbound SSH is NOT hardened: $SSHD_DROPIN is missing."
    echo "   This machine authorises inbound SSH keys, so password auth is open."
    echo "   Install it:"
    echo "     sudo tee $SSHD_DROPIN >/dev/null <<'SSHDEOF'"
{{- range .sshd.directives }}
    echo "     {{ . }}"
{{- end }}
    echo "     SSHDEOF"
    echo "     sudo chown root:wheel $SSHD_DROPIN && sudo chmod 644 $SSHD_DROPIN"
    echo "     sudo sshd -t && sudo sshd -T | grep -Ei 'passwordauth|kbdinteractive|permitroot'"
else
    _sshd_missing=""
{{- range .sshd.directives }}
    grep -qxF '{{ . }}' "$SSHD_DROPIN" 2>/dev/null || _sshd_missing="$_sshd_missing {{ . }};"
{{- end }}
    if [ -n "$_sshd_missing" ]; then
        echo "🔓 $SSHD_DROPIN exists but declared directives are missing:$_sshd_missing"
        echo "   Compare against .chezmoidata/sshd.yml, then re-check with:"
        echo "     sudo sshd -T | grep -Ei 'passwordauth|kbdinteractive|permitroot'"
    fi
fi
{{- end }}

# Check the macOS firewall allows mosh-server.
#
# Same gate as the sshd block: only a host that authorises inbound keys has a
# mosh server to expose. Same policy too - the rule needs root, so this REPORTS
# and prints the commands (see .chezmoidata/mosh.yml for why).
#
# Quiet when mosh-server is not installed (the package script already reports
# that, and the rule is meaningless without the binary) and when the firewall
# is off (nothing to allow through). `--listapps` needs no sudo; both the
# symlink and its resolved Cellar path are checked because the firewall may
# record either. `--getappblocked` is NOT used: it answers "permitted" for a
# path that does not exist, so it cannot tell "allowed" from "unknown".
{{- if and (eq .chezmoi.os "darwin") (index .fleet.sshAuthorizedKeys .machine.type) }}
MOSH_SERVER="{{ .mosh.server }}"
SFW=/usr/libexec/ApplicationFirewall/socketfilterfw
if [ -x "$MOSH_SERVER" ] && [ -x "$SFW" ] && "$SFW" --getglobalstate 2>/dev/null | grep -q 'enabled'; then
    _mosh_real="$(readlink -f "$MOSH_SERVER" 2>/dev/null || echo "$MOSH_SERVER")"
    # One entry is two lines: the path, then "(Allow incoming connections)" or
    # "(Block incoming connections)". grep -A1 pairs them.
    if ! "$SFW" --listapps 2>/dev/null \
        | grep -A1 -F -e "$MOSH_SERVER" -e "$_mosh_real" \
        | grep -q 'Allow incoming connections'; then
        echo "🔓 mosh-server is NOT allowed through the macOS firewall."
        echo "   mosh will silently fall back to SSH (no traffic on the UDP port)."
        echo "   Allow it (one-time, needs sudo):"
        echo "     sudo $SFW --add $MOSH_SERVER"
        echo "     sudo $SFW --unblockapp $MOSH_SERVER"
        echo "     $SFW --listapps | grep -A1 mosh-server"
    fi
fi
{{- end }}

echo "✅ Health check complete!"

# Hash for change detection: {{ .chezmoi.version }}-{{ .chezmoi.hostname }}-{{ now | date "2006-01-02" }}