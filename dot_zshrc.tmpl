# Optimized .zshrc managed by Chezmoi
# Generated for: {{ .name }} <{{ .email }}>
# Machine: {{ .machine.type }} ({{ .machine.performance }}) | Terminal: {{ .terminal }}

{{- if eq .chezmoi.hostname "FNVF299JMC" }}
# Kiro CLI pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zprofile.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zprofile.pre.zsh"
{{- end }}

# Performance: Early return for non-interactive sessions
[[ $- != *i* ]] && return

{{- if eq .machine.performance "high" }}
# High-performance machine optimizations
export HISTSIZE=100000
export HISTFILESIZE=100000
export SAVEHIST=100000
{{- else }}
# Resource-conscious settings for lower-spec machines
export HISTSIZE=10000
export HISTFILESIZE=10000
export SAVEHIST=10000
{{- end }}

# Load modular configuration files (skip exports - now in .zshenv)
for config in ~/.config/zsh/{functions,plugins,aliases,chezmoi-functions}.zsh; do
  [[ -r "$config" ]] && source "$config"
done

# Initialize completion system with caching
autoload -U compinit
{{- if eq .machine.performance "high" }}
# High-performance machines: cache completions for 24 hours
if [[ -n ${ZDOTDIR}/.zcompdump(#qN.mh+24) ]]; then
    compinit -i
else
    compinit -i -C
fi
{{- else }}
# Lower-spec machines: cache for 24 hours, skip security check
if [[ -n ${ZDOTDIR}/.zcompdump(#qN.mh+24) ]]; then
    compinit -i -u
else
    compinit -i -u -C
fi
{{- end }}

{{- if .features.ai_tools }}
# AI tools integration (file path already set in .zshenv)
{{- end }}

# GPG agent startup (disabled for performance)
# gpgconf --launch gpg-agent

# Setup lazy loading for performance
setup_lazy_loading

# Load additional configuration files
source_if_exists ~/.config/secrets.sh
source_if_exists "${HOME}/.local/bin/env"

{{- if eq .terminal "ghostty" }}
# Ghostty-specific configuration
# Add any Ghostty-specific settings here
{{- else if eq .terminal "wezterm" }}
# WezTerm-specific configuration  
# Add any WezTerm-specific settings here
{{- end }}

# Shell options
unsetopt correct_all  # Disable autocorrect

{{- if .features.development_tools }}
# Development-specific configurations (DEV_MODE set in .zshenv)

# Development aliases
alias dc="docker-compose"
alias dcu="docker-compose up -d"
alias dcd="docker-compose down"
alias dcl="docker-compose logs -f"

{{- if .features.kubernetes }}
# Kubernetes aliases
alias k="kubectl"
alias kgp="kubectl get pods"
alias kgs="kubectl get services"
alias kgd="kubectl get deployments"
{{- end }}

# Git shortcuts for development
alias gst="git status"
alias gaa="git add --all"
alias gcm="git commit -m"
alias gph="git push"
alias gpl="git pull"

# Node.js development (fnm and corepack configured in .zshenv)
{{- end }}

# Platform-specific configurations (PATH set in .zshenv)
{{- if eq .chezmoi.os "darwin" }}
# macOS specific settings

{{- if eq .machine.type "work" }}
# Work machine specific paths
export PATH="/opt/company-tools/bin:$PATH"
{{- end }}
{{- else if eq .chezmoi.os "linux" }}
# Linux specific settings
{{- end }}

# Terminal integration (conditionally load if files exist)
{{- if eq .terminal "wezterm" }}
source_if_exists "${HOME}/.config/wezterm/wezterm.sh"
{{- end }}

# iTerm2 integration (if present)
# source_if_exists "${HOME}/.iterm2_shell_integration.zsh"

# Claude Code CLI alias (if installed)
if [[ -x "${HOME}/.claude/local/claude" ]]; then
  alias claude="${HOME}/.claude/local/claude"
elif command -v claude >/dev/null 2>&1; then
  # Claude already in PATH
  alias claude="claude"
fi

# Google Cloud SDK integration (disabled for performance)
# if [ -f '/usr/local/share/google-cloud-sdk/path.zsh.inc' ]; then . '/usr/local/share/google-cloud-sdk/path.zsh.inc'; fi
# if [ -f '/usr/local/share/google-cloud-sdk/completion.zsh.inc' ]; then . '/usr/local/share/google-cloud-sdk/completion.zsh.inc'; fi

{{- if eq .chezmoi.hostname "FNVF299JMC" }}
# Kiro CLI post block. Keep at the bottom of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zprofile.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zprofile.post.zsh"
{{- end }}
