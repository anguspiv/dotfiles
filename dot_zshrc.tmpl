# Git branch cleanup function
# Deletes local branches that are:
# 1. Removed from remote (gone)
# 2. Merged into target branch
# 3. Squashed/rebased into target branch (detects via patch-id)
# Usage: git-cleanup [target-branch]
# Default target: main
git-cleanup() {
  local target="${1:-main}"
  
  echo "🧹 Cleaning up branches merged/squashed/rebased into $target..."
  
  # Fetch and prune
  echo "\n📡 Fetching and pruning remote references..."
  git fetch --prune
  
  # Delete gone branches
  echo "\n🗑️  Deleting branches removed from remote..."
  local gone_count=0
  git branch -vv | grep ': gone]' | awk '{print $1}' | while read branch; do
    echo "  ❌ $branch"
    git branch -D "$branch" 2>/dev/null && ((gone_count++))
  done
  
  # Delete merged branches
  echo "\n🔀 Deleting merged branches..."
  local merged_count=0
  git branch --merged "$target" | grep -v "^\*" | grep -v "main" | grep -v "master" | grep -v "$target" | while read branch; do
    echo "  ✓ $branch"
    git branch -d "$branch" 2>/dev/null && ((merged_count++))
  done
  
  # Delete squashed/rebased branches
  echo "\n🔍 Checking for squashed/rebased branches..."
  local squashed_count=0
  git for-each-ref refs/heads/ "--format=%(refname:short)" | while read branch; do
    # Skip protected branches
    [[ "$branch" == "main" ]] || [[ "$branch" == "master" ]] || \
    [[ "$branch" == "$target" ]] || [[ "$branch" == "$(git branch --show-current)" ]] && continue
    
    local merge_base=$(git merge-base "$target" "$branch" 2>/dev/null) || continue
    local branch_patches=$(git log --format=%H "$merge_base..$branch" 2>/dev/null | \
                          git patch-id --stable 2>/dev/null | cut -d' ' -f1 | sort)
    [[ -z "$branch_patches" ]] && continue
    
    local target_patches=$(git log --format=%H "$merge_base..$target" 2>/dev/null | \
                          git patch-id --stable 2>/dev/null | cut -d' ' -f1 | sort)
    
    local all_found=true
    for patch in $branch_patches; do
      echo "$target_patches" | grep -q "^$patch$" || { all_found=false; break; }
    done
    
    if [[ "$all_found" == "true" ]]; then
      echo "  🔄 $branch"
      git branch -D "$branch" 2>/dev/null && ((squashed_count++))
    fi
  done
  
  echo "\n✨ Branch cleanup complete!"
}
